{
  "name": "johnny-be-good",
  "version": "0.1.0",
  "description": "Test AI application behavior with deterministic checks, trace replay and validated judge workflows.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "johnny-be-good": "./dist/cli/main.js",
    "tracecheck": "./dist/cli/main.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm test",
    "prepare": "npm run build",
    "cli": "vite-node src/cli/main.ts"
  },
  "keywords": [
    "agents",
    "evals",
    "llm",
    "mcp",
    "claude-code",
    "tool-calling",
    "llm-as-judge"
  ],
  "dependencies": {
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "optionalDependencies": {
    "@anthropic-ai/sdk": "^1.9.0",
    "@typesafe-ai/sdk": "^0.7.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7",
    "vite-node": "3.2.4"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/juaninamilliom/tracecheck.git"
  }
}
